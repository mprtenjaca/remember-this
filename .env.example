# Copy to .env — Expo reads EXPO_PUBLIC_* at bundle time.
# URL of the deployed Cloudflare Worker (worker/). Safe to ship: it's only a URL.
# Leave empty → app runs fully offline with the local heuristic enricher.
EXPO_PUBLIC_AI_PROXY_URL=

# p0-harness only (never in the app): GEMINI_KEY=... npm run p0
# GEMINI_KEY=
